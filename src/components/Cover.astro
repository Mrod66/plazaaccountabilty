---
/**
 * A blog cover in one of three forms (`src/content.config.ts`):
 *   - an image in `src/assets/` (an object): optimised at build with
 *     astro:assets into AVIF + WebP at several widths, `sizes` for the slot;
 *   - a `/path` in `public/` or an https URL: served as it is.
 * Always sized (no layout shift). `eager` for the one image above the fold
 * (the LCP), lazy everywhere else.
 */
import type {ImageMetadata} from 'astro';
import {Picture} from 'astro:assets';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  class?: string;
  /** The display box: the image fills it (`object-fit: cover`). */
  width: number;
  height: number;
  /** `sizes` for the responsive widths: how wide the slot is on screen. */
  sizes: string;
  eager?: boolean;
}

const {src, alt, class: className, width, height, sizes, eager = false} = Astro.props;
const loading = eager ? 'eager' : 'lazy';
const fetchpriority = eager ? 'high' : undefined;
const widths = [width / 2, width, Math.min(width * 2, typeof src === 'string' ? width : src.width)]
  .map(Math.round)
  .filter((w, i, all) => all.indexOf(w) === i);
---

{
  typeof src === 'string' ? (
    <img class={className} src={src} alt={alt} width={width} height={height} loading={loading} decoding="async" fetchpriority={fetchpriority} />
  ) : (
    <Picture
      class={className}
      src={src}
      alt={alt}
      width={width}
      height={height}
      widths={widths}
      sizes={sizes}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      loading={loading}
      decoding="async"
      fetchpriority={fetchpriority}
    />
  )
}
