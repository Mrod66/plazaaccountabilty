---
import BrandMark from '../components/BrandMark.astro';
import {ABOUT, withName} from '../content/site';
import Base from '../layouts/Base.astro';
import {staticContext} from '../server/page';

// Static: built once, served as a file. The header fills the visitor in, in the browser.
export const prerender = true;

const {site, viewer} = await staticContext(Astro.request);
const name = site?.name ?? 'My site';
---

<Base site={site} viewer={viewer} isStatic title="About" description={withName(ABOUT.lede, name)}>
  <main id="main" tabindex="-1" class="wrap narrow section">
    <BrandMark site={site} size={56} />
    <h1 data-brand-text={ABOUT.title}>{withName(ABOUT.title, name)}</h1>
    <p class="lede">{withName(ABOUT.lede, name)}</p>
    {
      ABOUT.sections.map(section => (
        <section class="about-section">
          <h2>{section.heading}</h2>
          <p>{withName(section.body, name)}</p>
        </section>
      ))
    }
    <div class="actions">
      <a class="button ghost" href="/blog/" data-astro-prefetch>Read the blog</a>
    </div>
  </main>
</Base>
