---
/**
 * The <head> and body for an APP (the portal, or any signed-in app at its own
 * path). NOT the website layout: no site header, no footer, no centered
 * column. The app fills the viewport and draws its own shell (sidebar, top
 * bar) in React, so screens switch without a page load.
 *
 * Signed out / no access: pass the prompt as the slot; it renders
 * centered on the same full-height canvas.
 */
import '../styles/global.css';

import type {Site, Viewer} from '../lib/types';

interface Props {
  site: Site | null;
  viewer: Viewer;
  /** The app's name; the tab shows "<title> · <site>". */
  title: string;
}

const {site, viewer, title} = Astro.props;
const name = site?.name ?? 'Plaza Accountability Hub';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- One light theme only: phones in dark mode must still get dark text on white (DESIGN.md). -->
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#111111" />
    <title>{`${title} · ${name}`}</title>
    <!-- Signed-in screens are never search results. -->
    <meta name="robots" content="noindex" />
    {site?.favIcon ? <link rel="icon" href={site.favIcon} /> : <link rel="icon" href="/favicon.svg" type="image/svg+xml" />}
  </head>
  <body class="app-body" data-viewer={viewer.state}>
    <slot />

    <script>
      import {refreshSession} from '../platform/browser';

      // Same as the website layout: the server saw an expired access token but
      // a refresh cookie. Refresh ONCE in the browser, then re-render signed in.
      if (document.body.dataset.viewer === 'returning') {
        const key = 'site:refreshed';
        let first = true;
        try {
          first = !sessionStorage.getItem(key);
          sessionStorage.setItem(key, '1');
        } catch {
          // Storage blocked: no way to remember the reload, so never reload
          // (it would repeat on every load). The visitor signs in again.
          first = false;
        }
        if (first) void refreshSession().then(ok => ok && window.location.reload());
      } else {
        try {
          sessionStorage.removeItem('site:refreshed');
        } catch {
          // Storage blocked: nothing to clear.
        }
      }
    </script>
  </body>
</html>
